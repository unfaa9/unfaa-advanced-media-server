NODE_ENV=development
PORT=5000
# Prometheus metrics, bound to 127.0.0.1 only. Never proxy it publicly.
METRICS_PORT=9090
# Used to build returned URLs (https://media.unfaa.com in production)
PUBLIC_BASE_URL=http://localhost:5000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/media?schema=public"
# MUST be the persistent disk in production, e.g. /mnt/data/media
STORAGE_PATH=./.data
LOG_LEVEL=info
# Reverse proxy hops to trust for X-Forwarded-For; add "cloudflare" behind Cloudflare
TRUSTED_PROXIES=loopback

# Upload policy
# Default and maximum 15 MB (15728640)
MAX_FILE_BYTES=15728640
ALLOWED_KINDS=image,video,document
RATE_LIMIT_RPS=20
REQUIRE_ACCOUNT=false
# Applied to auto-created accounts; 0 = unlimited
DEFAULT_ACCOUNT_QUOTA_BYTES=5368709120
MIN_FREE_DISK_PERCENT=10

# Images (always compressed at the same resolution)
MAX_IMAGE_PIXELS=50000000
IMAGE_JPEG_QUALITY=80
IMAGE_PNG_QUALITY=80
IMAGE_WEBP_QUALITY=80
IMAGE_AVIF_QUALITY=55
IMAGE_MIN_SAVING_PERCENT=5
VARIANT_WIDTHS=64,128,256,512,768,1024,1536,2048
VARIANT_FORMATS=jpg,png,webp,avif
VARIANT_CACHE_MAX_BYTES=10737418240

# Lifecycle
PENDING_TTL_HOURS=24
TRASH_RETENTION_HOURS=168

# CDN purge on delete: none | cloudflare (token needs Zone → Cache Purge only)
CDN_PROVIDER=none
CF_ZONE_ID=
CF_API_TOKEN=
