        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "header": [],
            "description": "Soft-deletes all of the account's files and marks it deleted. Returns `{ \"deleted_files\": n }` (scope `accounts:write`).\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/accounts/{{accountRef}}",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts",
                "{{accountRef}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Audit logs",
      "item": [
