            }
          }
        },
        {
          "name": "Get account",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Usage: `ref`, `quota_bytes`, `used_bytes`, `file_count`, `usage_percent` (scope `accounts:read`).\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/accounts/{{accountRef}}",
