            "description": "Sensitive tier: encrypted at rest, audit-logged, no variants. `actor` is mandatory. `400` if the sensitive tier is not enabled on the deployment.\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files?visibility=sensitive&confirm=true&account={{accountRef}}&actor={{actor}}&purpose=passport",
              "host": [
