{
  "info": {
    "name": "Media Server API v1",
    "description": "All endpoints of the media server (see `docs/api/README.md`).\n\nSet `mediaBaseUrl` (local `http://localhost:8080`, production `https://media.unfaa.com`, inside Coolify `http://media-server:8080`) and `apiKey` (`msk_…`, created with `media-server admin key create`).\n\nSuggested order: Upload → Get/Confirm → Signed URL → Delivery → Delete → Restore.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Correlate requests with server logs; quote X-Request-Id when reporting problems.",
          "pm.request.headers.upsert({ key: 'X-Request-Id', value: pm.variables.replaceIn('{{$guid}}') });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "mediaBaseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiKey",
      "value": "msk_replace_me"
    },
    {
      "key": "fileId",
      "value": ""
    },
    {
      "key": "fileIds",
      "value": "[\"{{fileId}}\"]"
    },
    {
      "key": "fileExt",
      "value": "jpg"
    },
    {
      "key": "accountRef",
      "value": "agency_42"
    },
    {
      "key": "ownerRefPrefix",
      "value": "user:123:"
    },
    {
      "key": "actor",
      "value": "staff_17"
    },
    {
      "key": "signedUrl",
      "value": ""
    },
    {
      "key": "sensitiveUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "auth": {
        "type": "noauth"
      },
      "description": "Liveness and readiness probes (no API key).",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Process is up.",
            "url": {
              "raw": "{{mediaBaseUrl}}/healthz",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Database and storage are reachable.",
            "url": {
              "raw": "{{mediaBaseUrl}}/readyz",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "readyz"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Files – upload",
      "item": [
        {
          "name": "Upload file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Retries with the same key within 24 h replay the original response"
              }
            ],
            "description": "Uploads exactly one file (scope `files:write`). Choose a file in the Body tab. Type is detected by magic bytes: JPEG, PNG, WebP, GIF, MP4, WebM, PDF, DOCX. Saves `fileId` and `fileExt` for later requests.\n\n`400` bad params · `401` · `403` · `413` too large · `415` type not allowed · `422` corrupt · `429` · `507` quota/disk.\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files?visibility=public&confirm=true",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files"
              ],
              "query": [
                {
                  "key": "visibility",
                  "value": "public",
                  "description": "Required: public | private | sensitive"
                },
                {
                  "key": "confirm",
                  "value": "true",
                  "description": "true = active immediately; false = pending until confirm (auto-removed after 24 h)"
                },
                {
                  "key": "purpose",
                  "value": "avatar",
                  "description": "Free label, [A-Za-z0-9_.:@-], ≤ 128",
                  "disabled": true
                },
                {
                  "key": "owner_ref",
                  "value": "user:123:avatar",
                  "description": "<entity>:<id>:<field>; enables delete-by-owner",
                  "disabled": true
                },
                {
                  "key": "account",
                  "value": "{{accountRef}}",
                  "description": "Customer id for per-account quota (required if REQUIRE_ACCOUNT=true)",
                  "disabled": true
                },
                {
                  "key": "actor",
                  "value": "{{actor}}",
                  "description": "End-user id; required for sensitive uploads",
                  "disabled": true
                },
                {
                  "key": "optimize",
                  "value": "false",
                  "description": "false keeps image pixels untouched (metadata still stripped)",
                  "disabled": true
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Exactly one part named `file` (≤ 10 MB)"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ext = {'image/jpeg':'jpg','image/png':'png','image/webp':'webp','image/gif':'gif','video/mp4':'mp4',",
                  "  'video/webm':'webm','application/pdf':'pdf',",
                  "  'application/vnd.openxmlformats-officedocument.wordprocessingml.document':'docx'};",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const f = pm.response.json();",
                  "  pm.collectionVariables.set('fileId', f.id);",
                  "  if (ext[f.mime]) pm.collectionVariables.set('fileExt', ext[f.mime]);",
                  "}",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Idempotency-Key",
                    "value": "{{$guid}}",
                    "description": "Retries with the same key within 24 h replay the original response"
                  }
                ],
                "description": "Uploads exactly one file (scope `files:write`). Choose a file in the Body tab. Type is detected by magic bytes: JPEG, PNG, WebP, GIF, MP4, WebM, PDF, DOCX. Saves `fileId` and `fileExt` for later requests.\n\n`400` bad params · `401` · `403` · `413` too large · `415` type not allowed · `422` corrupt · `429` · `507` quota/disk.\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
                "url": {
                  "raw": "{{mediaBaseUrl}}/api/v1/files?visibility=public&confirm=true",
                  "host": [
                    "{{mediaBaseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "files"
                  ],
                  "query": [
                    {
                      "key": "visibility",
                      "value": "public",
                      "description": "Required: public | private | sensitive"
                    },
                    {
                      "key": "confirm",
                      "value": "true",
                      "description": "true = active immediately; false = pending until confirm (auto-removed after 24 h)"
                    },
                    {
                      "key": "purpose",
                      "value": "avatar",
                      "description": "Free label, [A-Za-z0-9_.:@-], ≤ 128",
                      "disabled": true
                    },
                    {
                      "key": "owner_ref",
                      "value": "user:123:avatar",
                      "description": "<entity>:<id>:<field>; enables delete-by-owner",
                      "disabled": true
                    },
                    {
                      "key": "account",
                      "value": "{{accountRef}}",
                      "description": "Customer id for per-account quota (required if REQUIRE_ACCOUNT=true)",
                      "disabled": true
                    },
                    {
                      "key": "actor",
                      "value": "{{actor}}",
                      "description": "End-user id; required for sensitive uploads",
                      "disabled": true
                    },
                    {
                      "key": "optimize",
                      "value": "false",
                      "description": "false keeps image pixels untouched (metadata still stripped)",
                      "disabled": true
                    }
                  ]
                },
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "type": "file",
                      "src": [],
                      "description": "Exactly one part named `file` (≤ 10 MB)"
                    }
                  ]
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"0192f3c4-7a1b-7c2e-9d10-5b6c7d8e9f00\",\n  \"status\": \"pending\",\n  \"visibility\": \"public\",\n  \"kind\": \"image\",\n  \"mime\": \"image/png\",\n  \"size\": 482113,\n  \"original_size\": 1904220,\n  \"compressed\": true,\n  \"sha256\": \"9f86d0\\u2026\",\n  \"width\": 1600,\n  \"height\": 1067,\n  \"url\": \"https://media.unfaa.com/f/0192f3c4-7a1b-7c2e-9d10-5b6c7d8e9f00.png\",\n  \"variants_url_template\": \"https://media.unfaa.com/i/0192f3c4-7a1b-7c2e-9d10-5b6c7d8e9f00/{w}.{fmt}\",\n  \"account\": \"agency_42\",\n  \"purpose\": \"product\",\n  \"original_name\": \"shoe.png\",\n  \"created_at\": \"2026-10-10T08:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Upload sensitive file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Retries with the same key within 24 h replay the original response"
              }
