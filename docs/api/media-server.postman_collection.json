                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ext = {'image/jpeg':'jpg','image/png':'png','image/webp':'webp','image/gif':'gif','video/mp4':'mp4',",
                  "  'video/webm':'webm','application/pdf':'pdf',",
                  "  'application/vnd.openxmlformats-officedocument.wordprocessingml.document':'docx'};",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const f = pm.response.json();",
                  "  pm.collectionVariables.set('fileId', f.id);",
                  "  if (ext[f.mime]) pm.collectionVariables.set('fileExt', ext[f.mime]);",
                  "}",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Files – metadata & lifecycle",
      "item": [
        {
          "name": "Get file",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Current state and metadata of one file (scope `files:read`). `404` unknown id.\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files/{{fileId}}",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}"
              ]
            }
          }
        },
        {
          "name": "List files",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Newest first, cursor paging: `{ \"data\": [...], \"next_cursor\": \"…\"|null }` (scope `files:read`).\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files?limit=50",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "≤ 200"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "next_cursor from the previous page",
                  "disabled": true
                },
                {
                  "key": "purpose",
                  "value": "",
                  "description": "Filter by purpose",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": "pending | active | deleted | purged",
                  "disabled": true
                },
                {
                  "key": "account",
                  "value": "{{accountRef}}",
                  "description": "Filter by account",
                  "disabled": true
                },
                {
                  "key": "owner_ref",
                  "value": "user:123:avatar",
                  "description": "Filter by owner_ref",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Confirm file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "`pending → active`; idempotent for `active` (scope `files:write`). `409 invalid_state` if deleted/purged.\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files/{{fileId}}/confirm",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_ref\": \"post:77:images\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Confirm files (batch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Confirm up to 100 ids, all-or-nothing (scope `files:write`). Any unknown (`404`) or unconfirmable (`409`) id changes nothing.\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files/confirm",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": {{fileIds}},\n  \"owner_ref\": \"post:77:images\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Files – delete & restore",
      "item": [
        {
          "name": "Delete file",
          "request": {
            "method": "DELETE",
            "header": [],
            "description": "Soft-delete; origin returns 404 immediately, CDN purge queued (scope `files:delete`). Idempotent `204`; unknown id `404`. Restorable for 7 days.\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files/{{fileId}}",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}"
              ],
              "query": [
                {
                  "key": "actor",
                  "value": "{{actor}}",
                  "description": "Recorded in the audit log for sensitive files",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Delete by owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Soft-deletes every pending/active file whose owner_ref starts with the prefix (≥ 3 chars, must end with `:`). Returns `{ \"deleted\": n }` (scope `files:delete`).\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files/delete-by-owner",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "delete-by-owner"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_ref_prefix\": \"{{ownerRefPrefix}}\",\n  \"actor\": \"{{actor}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Restore file",
          "request": {
            "method": "POST",
            "header": [],
            "description": "`deleted → active` within 7 days (scope `files:delete`). `409 invalid_state`, `507 quota_exceeded`.\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files/{{fileId}}/restore",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}",
                "restore"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Signed URLs",
      "item": [
        {
          "name": "Signed URL (private)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Expiring URL for a private file (scope `files:read`). `ttl` default 900, max 604800 s; `variant` optional, images only (w ∈ 64,128,256,512,768,1024,1536,2048; fmt jpg|png, webp|avif on libvips). For a public file this returns its permanent URL. Saves `signedUrl`.\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files/{{fileId}}/signed-url",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}",
                "signed-url"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ttl\": 900,\n  \"variant\": {\n    \"w\": 640,\n    \"fmt\": \"jpg\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('signedUrl', pm.response.json().url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Signed URL (sensitive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Grant-bound URL for a sensitive file: `actor` required, `reason` optional (≤ 500), `ttl` ≤ 300, no variant. Writes a `url_issued` audit event. Saves `sensitiveUrl`.\n\nErrors are `application/problem+json`; see `docs/api/errors.md`.",
            "url": {
              "raw": "{{mediaBaseUrl}}/api/v1/files/{{fileId}}/signed-url",
              "host": [
                "{{mediaBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "files",
                "{{fileId}}",
                "signed-url"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actor\": \"{{actor}}\",\n  \"reason\": \"visa processing\",\n  \"ttl\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('sensitiveUrl', pm.response.json().url);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Accounts",
