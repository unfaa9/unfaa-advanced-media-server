{
  "name": "unfaa-media-server",
  "version": "1.0.0",
  "description": "Media server: upload, compress, serve (Cloudflare CDN) and delete images, short videos, PDF and DOCX",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "admin": "node dist/cli.js admin",
    "admin:dev": "ts-node-dev --transpile-only src/cli.ts admin",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "test": "vitest run",
    "lint:check": "eslint --ignore-path .eslintignore --ext .js,.ts .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --write .",
    "lint-prettier": "npm run lint:check && npm run prettier:check",
    "postinstall": "prisma generate"
  },
  "author": "",
  "license": "ISC",
  "lint-staged": {
    "src/**/*.ts": "npm run lint-prettier"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.11",
    "@types/proxy-addr": "^2.0.3",
    "@types/send": "^1.2.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^7.0.0",
    "eslint-config-prettier": "^8.8.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "prettier": "^2.8.8",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^5.2.0",
    "@types/cookie-parser": "^1.4.3",
    "axios": "^1.6.5",
    "busboy": "^1.6.0",
    "commander": "^15.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "file-type": "^16.5.4",
    "http-status": "^1.6.2",
    "ipaddr.js": "^2.5.0",
    "multer": "^1.4.5-lts.1",
    "p-limit": "^3.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^5.2.0",
    "prom-client": "^15.1.3",
    "proxy-addr": "^2.0.8",
    "send": "^1.2.1",
    "sharp": "^0.34.1",
    "uuid": "^10.0.0",
    "yauzl": "^3.4.0",
    "zod": "^3.21.4"
  }
}
